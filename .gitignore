# Local AI-platform install footprints (created by `npx dev-workflow init`
# in this repo when used as a self-host harness during development).
# Each user's local setup; not part of the dev-workflow source.
.claude/
.codex/
.agents/
.opencode/
skills-lock.json

# .github/ is a local generated footprint (Copilot/agent wrappers) EXCEPT the
# committed CI workflow, which is source. Ignore everything under .github/ but
# keep .github/workflows/ci.yml tracked; generated agents stay ignored.
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/ci.yml

# Node
node_modules/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
